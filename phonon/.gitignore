configs/**/relax*/
configs/**/fc3_*/
configs/**/dfpt/
configs/**/pseudo/
configs/**/reaps/

# --- Reap data: regenerable DFT outputs (fc2/fc3/kappa regenerable from configs) ---
reaps/**/reference/
reaps/**/*.pdf
reaps/**/*.png
reaps/**/*.csv
reaps/**/*.hdf5
reaps/**/*.json
reaps/ge_primitive_work/
