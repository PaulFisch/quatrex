*.png

# Generated data (can be regenerated by running scripts)
*.npz

# SCBA checkpoint files
anharmonic_multislab_checkpoint.json
anharmonic/anharmonic_multislab_checkpoint.json

# Reap directories — DFT outputs, regeneratable but expensive.
