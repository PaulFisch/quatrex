reaps/**/results/
reaps/**/*.out
reaps/**/CRASH
reaps/**/input_tmp.in

# QE runtime artifacts
CRASH
input_tmp.in

# Checkpoint files at top level
anharmonic_checkpoint.npz

# Auto-generated configs (produced by examples/setup_*.py)
configs/si_primitive/prim_auto.yaml
configs/sinw/sinw100_d*_auto.yaml
configs/genw/genw100_d*_auto.yaml
configs/sigenw/sigenw100_fge*_auto.yaml
configs/cnt/cnt33_finite_n*_auto.yaml
configs/chain/si_chain_n*_auto.yaml

