&CONTROL
   calculation      = 'scf'
   restart_mode     = 'from_scratch'
   prefix           = 'fc3_disp'
   pseudo_dir       = '../scf_disp/pseudo'
   outdir           = './results'
   tprnfor          = .true.
/
&SYSTEM
   ibrav            = 0
   nat              = ##NATOMS##
   ntyp             = 1
   ecutwfc          = 36
   ecutrho          = 288
   occupations      = 'smearing'
   smearing         = 'gaussian'
   degauss          = 0.01
/
&ELECTRONS
   conv_thr         = 1e-10
/
ATOMIC_SPECIES
  Si  28.085  Si.pbe-n-rrkjus_psl.1.0.0.UPF
##COORDINATES##
##CELL##
K_POINTS automatic
  4 4 4  0 0 0
