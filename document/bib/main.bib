@misc{zheng_distdgl_2021,
	title = {{DistDGL}: Distributed Graph Neural Network Training for Billion-Scale Graphs},
	url = {http://arxiv.org/abs/2010.05337},
	doi = {10.48550/arXiv.2010.05337},
	shorttitle = {{DistDGL}},
	abstract = {Graph neural networks ({GNN}) have shown great success in learning from graph-structured data. They are widely used in various applications, such as recommendation, fraud detection, and search. In these domains, the graphs are typically large, containing hundreds of millions of nodes and several billions of edges. To tackle this challenge, we develop {DistDGL}, a system for training {GNNs} in a mini-batch fashion on a cluster of machines. {DistDGL} is based on the Deep Graph Library ({DGL}), a popular {GNN} development framework. {DistDGL} distributes the graph and its associated data (initial features and embeddings) across the machines and uses this distribution to derive a computational decomposition by following an owner-compute rule. {DistDGL} follows a synchronous training approach and allows ego-networks forming the mini-batches to include non-local nodes. To minimize the overheads associated with distributed computations, {DistDGL} uses a high-quality and light-weight min-cut graph partitioning algorithm along with multiple balancing constraints. This allows it to reduce communication overheads and statically balance the computations. It further reduces the communication by replicating halo nodes and by using sparse embedding updates. The combination of these design choices allows {DistDGL} to train high-quality models while achieving high parallel efficiency and memory scalability. We demonstrate our optimizations on both inductive and transductive {GNN} models. Our results show that {DistDGL} achieves linear speedup without compromising model accuracy and requires only 13 seconds to complete a training epoch for a graph with 100 million nodes and 3 billion edges on a cluster with 16 machines. {DistDGL} is now publicly available as part of {DGL}:https://github.com/dmlc/dgl/tree/master/python/dgl/distributed.},
	number = {{arXiv}:2010.05337},
	publisher = {{arXiv}},
	author = {Zheng, Da and Ma, Chao and Wang, Minjie and Zhou, Jinjing and Su, Qidong and Song, Xiang and Gan, Quan and Zhang, Zheng and Karypis, George},
	urldate = {2025-02-23},
	date = {2021-08-02},
	eprinttype = {arxiv},
	eprint = {2010.05337 [cs]},
	keywords = {Computer Science - Machine Learning, Computer Science - Distributed, Parallel, and Cluster Computing},
	file = {Preprint PDF:/home/paul/snap/zotero-snap/common/Zotero/storage/EVZDIISI/Zheng et al. - 2021 - DistDGL Distributed Graph Neural Network Training for Billion-Scale Graphs.pdf:application/pdf;Snapshot:/home/paul/snap/zotero-snap/common/Zotero/storage/WHD2876H/2010.html:text/html},
}

@misc{rahman_fusedmm_2021,
	title = {{FusedMM}: A Unified {SDDMM}-{SpMM} Kernel for Graph Embedding and Graph Neural Networks},
	url = {http://arxiv.org/abs/2011.06391},
	doi = {10.48550/arXiv.2011.06391},
	shorttitle = {{FusedMM}},
	abstract = {We develop a fused matrix multiplication kernel that unifies sampled dense-dense matrix multiplication and sparse-dense matrix multiplication under a single operation called {FusedMM}. By using user-defined functions, {FusedMM} can capture almost all computational patterns needed by popular graph embedding and {GNN} approaches. {FusedMM} is an order of magnitude faster than its equivalent kernels in Deep Graph Library. The superior performance of {FusedMM} comes from the low-level vectorized kernels, a suitable load balancing scheme and an efficient utilization of the memory bandwidth. {FusedMM} can tune its performance using a code generator and perform equally well on Intel, {AMD} and {ARM} processors. {FusedMM} speeds up an end-to-end graph embedding algorithm by up to 28x on different processors.},
	number = {{arXiv}:2011.06391},
