@misc{jia_using_2001,
	location = {Rochester, {NY}},
	title = {Using Cross-Product Matrices to Compute the Svd},
	url = {https://papers.ssrn.com/abstract=3162753},
	abstract = {This paper concerns accurate computation of the singular value decomposition ({SVD}) of an  ×  matrix . As is well known, cross-product matrix based {SVD} algorithms compute large singular values accurately but generally deliver poor small singular values. A new novel cross-product matrix based {SVD} method is proposed: (a) use a backward stable algorithm to compute the eigenpairs of  and take the square roots of the large eigenvalues of it as the large singular values of ; (b) form the Rayleigh quotient of  with respect to the matrix consisting of the computed eigenvectors associated with the computed small eigenvalues of ; (c) compute the eigenvalues of the Rayleigh quotient and take the square roots of them as the small singular values of . A detailed quantitative error analysis is conducted on the method. It is proved that if small singular values are well separated from the large ones then the method can compute the small ones accurately up to the order of the unit roundoff . An algorithm is developed that is not only cheaper than the Golub—Reinsch and Chan {SVD} algorithms but also can accurately update or downdate the {SVD} when a row is appended to or deleted from  and compute certain refined Ritz vectors for large matrix eigenproblems at low cost. Several variants of the algorithm are proposed that compute some or all parts of the {SVD}. Typical numerical examples confirm the high accuracy of the algorithm.},
	number = {3162753},
	author = {Jia, Zhongxiao},
	urldate = {2023-06-19},
	date = {2001-06-01},
	langid = {english},
	keywords = {15A12, 15A18, 65F15, 65F30, 65G05, cross-product matrix, eigenvalue, eigenvector, error analysis, exact arithmetic, finite precision arithmetic, Rayleigh quotient, singular value, singular vector, {SVD}},
}

